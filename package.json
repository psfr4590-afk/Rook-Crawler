{
  "name": "rook-crawler",
  "version": "2.1.0",
  "description": "Local web crawler with a hardened Node proxy, optional Tor routing, DoH validation, browser fingerprinting, and adaptive crawl intelligence.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "lint": "node --check server.js && node --check tests/security.test.js"
  },
  "keywords": [
    "crawler",
    "web-scraper",
    "proxy",
    "tor",
    "doh",
    "fingerprinting",
    "cuimp",
    "socks5"
  ],
  "author": "John Petty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/psfr4590-afk/Rook-Crawler.git"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "4.22.3",
    "cuimp": "2.1.1"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "preferGlobal": false
}
